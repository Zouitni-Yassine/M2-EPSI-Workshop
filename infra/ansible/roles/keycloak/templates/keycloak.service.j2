# {{ ansible_managed }}
[Unit]
Description=Keycloak
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
User=keycloak
Group=keycloak
EnvironmentFile=/etc/keycloak/bootstrap.env
EnvironmentFile=/etc/keycloak/db.env
ExecStart=/opt/keycloak/current/bin/kc.sh --config-file=/etc/keycloak/keycloak.conf start --optimized
# Port 443 sans être root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5
LimitNOFILE=65536
SuccessExitStatus=143

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/keycloak/{{ keycloak_version }}/data

[Install]
WantedBy=multi-user.target
