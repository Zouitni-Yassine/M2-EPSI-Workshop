# {{ ansible_managed }}
# Seules les valeurs modifiées sont listées, le reste vient de defaults.ini

[server]
http_port = 3000
root_url = http://{{ ansible_host }}:3000/

[security]
admin_user = admin
# Mot de passe : GF_SECURITY_ADMIN_PASSWORD dans /etc/grafana/secrets.env (jamais ici)
disable_gravatar = true

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false
