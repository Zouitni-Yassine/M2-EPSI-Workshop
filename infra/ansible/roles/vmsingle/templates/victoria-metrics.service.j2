# {{ ansible_managed }}
# Écoute locale : les clients passent par vmauth (:{{ vm_public_port }}, tasks/vmauth.yml), qui
# ajoute l'authentification de ce compte. L'authentification native reste active derrière.
[Unit]
Description=VictoriaMetrics single-node
Wants=network-online.target
After=network-online.target

[Service]
User=victoriametrics
Group=victoriametrics
ExecStart=/usr/local/bin/victoria-metrics \
  -httpListenAddr={{ vm_backend_listen }} \
  -httpAuth.username={{ monitoring_auth_user }} \
  -httpAuth.password=file:///etc/victoria-metrics/http_password \
  -storageDataPath=/var/lib/victoria-metrics \
  -retentionPeriod={{ vm_retention }} \
  -dedup.minScrapeInterval={{ scrape_interval }}
Restart=always
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/victoria-metrics

[Install]
WantedBy=multi-user.target
