# {{ ansible_managed }}
DATA_FOLDER=/var/lib/vaultwarden
WEB_VAULT_FOLDER=/opt/vaultwarden/current/web-vault
DOMAIN=https://{{ ansible_host }}
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=443
ROCKET_TLS='{certs="/etc/vaultwarden/tls.crt",key="/etc/vaultwarden/tls.key"}'

# Pas d'inscription libre : comptes créés par invitation depuis /admin
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
PASSWORD_ITERATIONS=600000
ADMIN_TOKEN='{{ vaultwarden_admin_hash.stdout | trim }}'

# Journal : connexions et échecs (journald, donc Loki)
LOG_LEVEL=info
EXTENDED_LOGGING=true
IP_HEADER=none
