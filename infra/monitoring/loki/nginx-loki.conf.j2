# {{ ansible_managed }}
# Authentification Basic devant Loki (qui écoute sur 127.0.0.1:3101)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

# Compte en lecture seule de l'assistant RAG ({{ rag_readonly_user }}) : requêtes uniquement.
# $remote_user est le nom annoncé dans l'en-tête ; le mot de passe est vérifié ensuite par
# auth_basic. Annoncer {{ rag_readonly_user }} ne donne donc jamais plus que ces routes.
map "$remote_user:$uri" $loki_ro_denied {
    "~^{{ rag_readonly_user }}:/loki/api/v1/(query|query_range|labels|label/[^/]+/values|series)$" 0;
    "~^{{ rag_readonly_user }}:" 1;
    default 0;
}

server {
    listen 3100;
    listen [::]:3100;
    server_name _;

    auth_basic "Loki";
    auth_basic_user_file /etc/nginx/loki.htpasswd;

    # Pas de journal d'accès (un push par seconde et par hôte). Les erreurs, dont les échecs
    # d'authentification, partent dans journald, donc dans Loki.
    access_log off;
    error_log syslog:server=unix:/dev/log,tag=nginx_loki error;

    client_max_body_size 16m;   # lots de logs poussés par Alloy
    proxy_read_timeout 300s;    # requêtes longues depuis Grafana

    location / {
        if ($loki_ro_denied) { return 403; }
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Live tail Grafana (WebSocket)
    location /loki/api/v1/tail {
        if ($loki_ro_denied) { return 403; }
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }
}
