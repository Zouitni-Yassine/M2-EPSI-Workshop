    {
      "id": 2,
      "type": "stat",
      "title": "Lignes de logs",
      "description": "Lignes reçues de rag01 pour les sources sélectionnées (l'indexation Ollama en produit beaucoup pendant une resynchronisation).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({host=~\"$host\", unit=~\"$source\"} | line_format `{{ regexReplaceAll \"utilisateur=.*? statut=\" __line__ \"statut=\" }}` |~ `(?i)$recherche` [$__range])) or vector(0)",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant"
