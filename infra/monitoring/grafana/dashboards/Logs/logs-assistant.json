        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "avg(avg_over_time({host=\"rag01\", unit=\"rag-api.service\"} |= \"question \" | regexp `duree=(?P<duree>[0-9.]+)s` | unwrap duree | __error__=\"\" [$__range]))",
