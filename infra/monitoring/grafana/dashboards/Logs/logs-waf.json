    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs",
      "description": "Lignes contenant un mot-clé d'erreur (y compris les refus ModSecurity « Access denied »). Bruit exclu : réponses nginx mises en tampon, « syslogin_perform_logout » des LXC.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({host=~\"$host\", identifier=~\"$source\"} != `buffered to a temporary file` != `syslogin_perform_logout` |~ `(?i)(error|erreur|fail|échec|echec|crit|fatal|panic|denied|refused|timeout|traceback|exception)` |~ `(?i)$recherche` [$__range])) or vector(0)",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "unit": "short",
          "noValue": "0",
          "color": {
