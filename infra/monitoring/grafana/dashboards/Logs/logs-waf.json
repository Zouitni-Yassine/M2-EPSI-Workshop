    {
      "id": 2,
      "type": "stat",
      "title": "Lignes de logs",
      "description": "Lignes reçues sur la période pour les machines et sources sélectionnées.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({host=~\"$host\", identifier=~\"$source\"} |~ `(?i)$recherche` [$__range])) or vector(0)",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
