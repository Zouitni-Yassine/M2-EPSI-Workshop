        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({host=~\"$host\", job=\"journal\", identifier=~\"$source\", identifier!~\"ansible-.*\"} |~ `(?i)$recherche` [$__range])) or vector(0)",
          "legendFormat": "",
