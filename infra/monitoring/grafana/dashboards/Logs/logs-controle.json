        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "description": "Programmes (SYSLOG_IDENTIFIER) du journal : sauvegardes, SSH, planificateur Proxmox, cron, collecteur Alloy.",
        "query": {
          "type": 1,
          "label": "identifier",
          "stream": "{host=~\"$host\", job=\"journal\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({host=~\"$host\", job=\"journal\"},identifier)",
        "regex": "/^(?:paiement-db-backup|sshd|sshd-session|pvescheduler|pvedaemon|systemd-logind|CRON|cron|sudo|su|alloy-wrapper)$/",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
