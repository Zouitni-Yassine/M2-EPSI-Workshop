    {
      "id": 2,
      "type": "stat",
      "title": "Lignes de logs",
      "description": "Lignes reçues des managers et workers Swarm pour les sources sélectionnées (hors conteneurs applicatifs : voir Logs - Paiement / Base / Remédiation).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({host=~\"$host\", identifier=~\"dockerd|containerd|Keepalived.*|ipvsadm-start|registry_registry.*|cadvisor|monitoring_vmagent.*|kernel|systemd\"} | label_format src=`{{ regexReplaceAll \"[.][0-9]+[.].*\" .identifier \"\" }}` | src=~\"$source\" |~ `(?i)$recherche` [$__range])) or vector(0)",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
