    {
      "id": 5,
      "type": "stat",
      "title": "Primaire actuel",
      "description": "Nœud Patroni qui détient le verrou de leader dans etcd (dernière minute) : c'est le primaire PostgreSQL, les autres sont des réplicas. « AUCUN » = pas de primaire, écritures impossibles. Ne dépend pas des variables.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (noeud) (count_over_time({stack=\"paiement\", service=~\"paiement_db[123]\"} |= \"the leader with the lock\" | regexp `I am \\((?P<noeud>[a-z0-9]+)\\)` [1m]))",
          "legendFormat": "{{noeud}}",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 0,
          "noValue": "AUCUN",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
