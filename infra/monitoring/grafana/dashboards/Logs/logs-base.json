    {
      "id": 2,
      "type": "stat",
      "title": "Lignes de logs",
      "description": "Lignes écrites par les nœuds choisis sur la période. Patroni écrit une ligne de battement toutes les 10 s par nœud.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "(sum(count_over_time({stack=\"paiement\", service=~\"$source\", host=~\"$host\"} |~ \"(?i)$recherche\" [$__range]))) or vector(0)",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {}
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs",
      "description": "Lignes ERROR / FATAL / PANIC de PostgreSQL et Patroni, level error d'etcd. Au redémarrage d'un réplica, quelques FATAL sont normaux (« the database system is starting up », « replication slot is active ») tant qu'ils cessent en moins d'une minute.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "(sum(count_over_time({stack=\"paiement\", service=~\"$source\", host=~\"$host\"} |~ `(?i)(,[0-9]+ (ERROR|CRITICAL|FATAL):|\\] (ERROR|FATAL|PANIC):|\"level\":\"(error|fatal|panic|dpanic)\"|traceback)` |~ \"(?i)$recherche\" [$__range]))) or vector(0)",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {}
      }
    },
    {
