    {
      "id": 10,
      "type": "logs",
      "title": "Erreurs et avertissements (PostgreSQL, Patroni, etcd) (24 h)",
      "description": "Lignes de gravité warning ou plus, préfixées par « nœud @ machine », horodatage interne retiré. Repères : « replication slot … is active » et « could not start WAL streaming » au redémarrage d'un réplica = transitoire ; « peer became inactive » (etcd) = un membre etcd est tombé ; « failed to resolve host » = conteneur voisin pas encore démarré. Plage propre au panneau : 24 dernières heures (événements rares), quelle que soit la période du dashboard.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{stack=\"paiement\", service=~\"$source\", host=~\"$host\"} |~ `(?i)(,[0-9]+ (ERROR|CRITICAL|FATAL|WARNING):|\\] (ERROR|FATAL|PANIC|WARNING):|\"level\":\"(warn|error|fatal|panic|dpanic)\"|traceback)` |~ \"(?i)$recherche\" | line_format `{{ trimPrefix \"paiement_\" .service }} @ {{ .host }} │ {{ regexReplaceAll \"^[0-9-]+ [0-9:.,]+ (UTC \\\\[[0-9]+\\\\] )?\" __line__ \"\" }}`",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "Aucun événement sur la période (normal hors incident)",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
