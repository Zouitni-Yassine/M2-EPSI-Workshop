          },
          "refId": "A",
          "expr": "{stack=\"paiement\", service=~\"$source\", host=~\"$host\"} |~ `(?i)(\"level\": \"(error|critical|warning)\"|level=(error|fatal|warn)|\\[(error|crit|alert|emerg|warn)\\]|HTTP/[0-9.]+\" 5[0-9]{2} |traceback|exception|panic)` !~ `column \"first_name\" already exists` |~ \"(?i)$recherche\" | line_format `{{ trimPrefix \"paiement_\" .service }} @ {{ .host }} │ {{ regexReplaceAll \"(?i)(bearer\\\\s+)[A-Za-z0-9._~+/=-]+\" (regexReplaceAll \"(?i)((token|passw[a-z]*|pwd|secret|api_?key|authorization|session_?id|cookie)[a-z_]*\\\"?\\\\s*[=:]\\\\s*\\\"?)[^&\\\\s\\\",]+\" __line__ \"${1}***\") \"${1}***\" }}`",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 500
        }
