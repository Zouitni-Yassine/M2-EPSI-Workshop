    {
      "id": 2,
      "type": "stat",
      "title": "Lignes de logs",
      "description": "Lignes reçues pour les sources sélectionnées. Loki journalise chacune de ses requêtes : c'est la source la plus bavarde.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({host=~\"$host\", identifier=~\"loki|grafana|prometheus-alertmanager|vmalert|victoria-metrics|vmauth|vmagent|monitoring_vmagent.*|pve_exporter|alloy-wrapper\"} | label_format src=`{{ regexReplaceAll \"[.][0-9]+[.].*\" .identifier \"\" }}` | src=~\"$source\" |~ `(?i)$recherche` [$__range])) or vector(0)",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {}
