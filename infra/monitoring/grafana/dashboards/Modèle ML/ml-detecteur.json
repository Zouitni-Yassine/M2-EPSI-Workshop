    {
      "id": 2,
      "type": "stat",
      "title": "Modèle",
      "description": "PRÊT : la normale est apprise, chaque seconde reçoit un score. ÉCHAUFFEMENT : le modèle apprend (60 premières secondes où l'API répond, après un redémarrage du détecteur ou un POST /reset). INJOIGNABLE : /metrics ne répond plus (alerte PaiementDetectorDown au bout de 2 min). Mesure toutes les 30 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "max(detector_ready{service=\"paiement_detector\"}) or vector(-1)",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "PRÊT",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ÉCHAUFFEMENT",
                  "color": "orange",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "INJOIGNABLE",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
