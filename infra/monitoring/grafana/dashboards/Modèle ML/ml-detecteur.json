          "uid": "loki"
        },
        "expr": "{stack=\"paiement\", service=\"paiement_detector\"} |~ \"Application startup complete|POST /reset\"",
        "instant": false,
        "titleFormat": "Réapprentissage du modèle",
        "textFormat": "Détecteur démarré ou réinitialisé sur {{host}} : échauffement de 60 s",
        "tagKeys": "host"
