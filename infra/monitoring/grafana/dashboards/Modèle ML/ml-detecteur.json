          },
          "refId": "A",
          "expr": "max(max_over_time({stack=\"probe\", service=\"probe_transactions\"} |= \"type=etat\" | logfmt score | __error__=\"\" | unwrap score [$__interval]))",
          "legendFormat": "score (5 s)",
          "editorMode": "code",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
