            "uid": "victoriametrics"
          },
          "expr": "clamp_min(scalar(max(patroni_xlog_location{stack=\"paiement\"} and on (instance) patroni_primary{stack=\"paiement\"} == 1)) - (patroni_xlog_received_location{stack=\"paiement\"} and on (instance) patroni_replica{stack=\"paiement\"} == 1), 0)",
