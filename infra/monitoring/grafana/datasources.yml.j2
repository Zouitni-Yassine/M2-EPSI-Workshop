# {{ ansible_managed }}
apiVersion: 1

datasources:
  # VictoriaMetrics expose l'API Prometheus : source de type prometheus
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: http://127.0.0.1:8428
    basicAuth: true
    basicAuthUser: {{ monitoring_auth_user }}
    secureJsonData:
      basicAuthPassword: {{ vm_auth_password }}
    isDefault: true
    editable: false
    jsonData:
      timeInterval: {{ scrape_interval }}

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://127.0.0.1:3100
    basicAuth: true
    basicAuthUser: {{ monitoring_auth_user }}
    secureJsonData:
      basicAuthPassword: {{ loki_auth_password }}
    editable: false

  - name: Alertmanager
    uid: alertmanager
    type: alertmanager
    access: proxy
    url: http://127.0.0.1:9093
    basicAuth: true
    basicAuthUser: {{ monitoring_auth_user }}
    secureJsonData:
      basicAuthPassword: {{ alertmanager_auth_password }}
    editable: false
    jsonData:
      implementation: prometheus
