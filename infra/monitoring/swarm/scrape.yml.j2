# Géré par Ansible (rendu par le rôle swarm_monitoring)
# vmagent du Swarm : métriques des services applicatifs (variable swarm_scrape_targets).
# Découverte par DNS : tasks.<service> renvoie l'IP overlay de chaque réplica.
global:
  scrape_interval: {{ scrape_interval }}
  scrape_timeout: 10s

scrape_configs:
  - job_name: vmagent-swarm
    static_configs:
      - targets: ["localhost:8429"]
        labels: { service: monitoring_vmagent, stack: monitoring }
{% for t in swarm_scrape_targets %}

  - job_name: {{ t.service }}
    metrics_path: {{ t.path | default('/metrics') }}
    dns_sd_configs:
      - names: ["tasks.{{ t.service }}"]
        type: A
        port: {{ t.port }}
    relabel_configs:
      - target_label: service
        replacement: {{ t.service }}
      - target_label: stack
        replacement: {{ t.service.split('_')[0] }}
{% endfor %}
