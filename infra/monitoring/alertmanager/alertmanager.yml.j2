# {{ ansible_managed }}
global:
  resolve_timeout: 5m

route:
  receiver: {{ 'discord' if discord_webhook_url | length > 0 else 'default' }}
  group_by: [alertname, job]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Heartbeat vers le watchdog externe, renvoyé chaque minute (jamais vers Discord)
    - matchers: ['alertname="Watchdog"']
      receiver: {{ 'healthchecks' if healthchecks_ping_url | length > 0 else 'blackhole' }}
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    # Bannissement automatique au WAF (règles Loki waf-ban.yml, label action="ban") : une
    # notification par IP, envoyée vite au récepteur de waf01 (sans les résolutions : le
    # bannissement expire seul), puis aussi vers Discord pour prévenir les humains
    - matchers: ['action="ban"']
      receiver: {{ 'waf-ban' if waf_ban_token | length > 0 else 'blackhole' }}
      group_by: [alertname, source_ip]
      group_wait: 5s
      group_interval: 1m
      repeat_interval: 15m
      continue: true
    - matchers: ['action="ban"']
      receiver: {{ 'discord' if discord_webhook_url | length > 0 else 'default' }}
      group_by: [alertname, source_ip]
      group_wait: 5s

receivers:
  # À brancher plus tard : moteur de remédiation (webhook)
  - name: default
  - name: blackhole
{% if healthchecks_ping_url | length > 0 %}
  - name: healthchecks
    webhook_configs:
      - url_file: /etc/prometheus/healthchecks_url
        send_resolved: false
{% endif %}
{% if waf_ban_token | length > 0 %}
  - name: waf-ban
    webhook_configs:
      - url: {{ waf_ban_url }}
        send_resolved: false
        max_alerts: 20
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/prometheus/waf_ban_token
{% endif %}
{% if discord_webhook_url | length > 0 %}
  - name: discord
    # Copie de chaque notification Discord pour le journal du back-office (page Supervision,
    # panneau Alertes) : nginx local de monitoring01, une ligne JSON par envoi, lue par Alloy
    # puis Loki (job alertmanager-notify). Même groupe, même moment, résolutions comprises.
    webhook_configs:
      - url: {{ alertmanager_notify_log_url }}
        send_resolved: true
    discord_configs:
      - webhook_url_file: /etc/prometheus/discord_webhook_url
        send_resolved: true
{% raw %}
        title: >-
          {{ if eq .Status "firing" }}🔥 ALERTE{{ else }}✅ RÉSOLU{{ end }}
          {{ .CommonLabels.alertname }}{{ if gt (len .Alerts.Firing) 1 }} ({{ len .Alerts.Firing }}){{ end }}
        message: |-
          {{ range .Alerts }}**[{{ .Labels.severity | toUpper }}]** {{ .Annotations.summary }}
          {{ if .Labels.host }}hôte : `{{ .Labels.host }}` · {{ end }}depuis {{ .StartsAt.Local.Format "15:04:05" }}{{ if eq .Status "resolved" }}, résolue à {{ .EndsAt.Local.Format "15:04:05" }}{{ end }}
          {{ end }}
{% endraw %}
{% endif %}
