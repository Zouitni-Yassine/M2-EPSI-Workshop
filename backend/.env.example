# Copier en .env (ignoré par Git). En production : injecté par Vault ou SOPS.
STRIPE_SECRET_KEY=sk_test_xxx
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://192.168.137.1:5173
# Service d'authentification : sa clé publique (/auth/jwks.json) sert à vérifier les jetons.
AUTH_URL=http://localhost:8300

# PayPal sandbox : developer.paypal.com > Apps & Credentials > onglet Sandbox.
# L'API visée est figée sur api-m.sandbox.paypal.com : aucun paiement réel possible.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Ou bien un fichier (secret Docker, Vault Agent, SOPS) à la place de la ligne ci-dessus :
# PAYPAL_CLIENT_SECRET_FILE=/run/secrets/paypal_client_secret
# Plafond d'appels sortants vers PayPal, pour qu'une attaque sur l'API ne rebondisse pas chez lui.
PAYPAL_MAX_RPS=5
