# Copier en .env (ignoré par Git).
API_URL=http://localhost:8000/api
# Secondes de trafic normal à observer avant de scorer. 120 en démo, 30 pour développer.
WARMUP_SECONDS=120
THRESHOLD=0.55
# Jeton exigé par POST /reset (en-tête X-Admin-Token). Absent = réinitialisation désactivée.
DETECTOR_ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
