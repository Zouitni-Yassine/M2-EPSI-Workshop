# Copier en .env (ignoré par Git).

# Paiement : avec ces deux lignes renseignées et le backend joignable, le tunnel
# passe par Stripe en mode test. Sinon, simulation locale hors ligne (bannière affichée).
VITE_API_URL=http://localhost:8000/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Supervision : mock = scénario rejoué en boucle, live = WebSocket du moteur de remédiation
VITE_DATA_SOURCE=mock
VITE_WS_URL=ws://localhost:8080/ws/state
