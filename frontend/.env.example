# Copier en .env (ignoré par Git). Ne sert qu'à « npm run dev » : sous Docker, ce sont les
# arguments de build de docker-compose.yml qui comptent.

# URL relatives : l'application appelle sa propre origine. Sous Docker, le frontal nginx
# relaie vers les services ; en « npm run dev », c'est Vite (voir vite.config.ts).
# Une URL absolue vers un autre port casserait la session : le cookie ne partirait pas.
VITE_API_URL=/api
VITE_AUTH_URL=

# Paiement : avec la clé renseignée et le backend joignable, le tunnel passe par Stripe en
# mode test. Sinon, simulation locale hors ligne (bannière affichée).
# own = nos champs, carte animée, jetons de test côté serveur · elements = iframes Stripe (production)
VITE_CARD_ENTRY=own
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# PayPal sandbox : le client ID (public) de l'app sandbox. Le secret reste dans backend/.env.
# Vide ou backend sans identifiants PayPal → le bouton PayPal n'apparaît pas.
VITE_PAYPAL_CLIENT_ID=

# Supervision : mock = scénario rejoué en boucle · api = payment-api et Stripe sondés en direct · ws = moteur de remédiation
VITE_DATA_SOURCE=api
VITE_DETECTOR_URL=/detector
VITE_REMEDIATION_URL=/remediation
VITE_WS_URL=ws://localhost:8080/ws/state
