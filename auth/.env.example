# Copier en .env (ignoré par Git). En production : injecté par Vault ou SOPS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://192.168.137.1:5173

# Comptes créés (ou mis à jour) au démarrage : identifiant:rôle, rôles client ou operator.
# Le mot de passe de chacun : AUTH_PASSWORD_<IDENTIFIANT EN MAJUSCULES>, 8 caractères minimum.
# Sans mot de passe, le compte n'est pas créé.
AUTH_SEED_USERS=operateur:operator,client:client
AUTH_PASSWORD_OPERATEUR=
AUTH_PASSWORD_CLIENT=
# Ou bien un fichier (secret Docker, Vault Agent, SOPS) à la place de la ligne :
# AUTH_PASSWORD_OPERATEUR_FILE=/run/secrets/auth_password_operateur

# Durée de validité d'une session.
TOKEN_TTL_MINUTES=120

# Base et clé de signature : fournies par docker-compose.yml (PostgreSQL + secrets Docker).
# Service lancé seul, sans elles : SQLite et clé Ed25519 générée dans AUTH_DATA_DIR.
# AUTH_DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://auth@localhost:5432/auth
# DB_PASSWORD_FILE=../secrets/auth_db_password.txt
# JWT_PRIVATE_KEY_FILE=../secrets/jwt_private_key.pem

# Force brute : échecs tolérés en AUTH_LOCKOUT_SECONDS, par adresse + identifiant, puis par adresse.
AUTH_MAX_FAILURES=5
AUTH_MAX_FAILURES_PER_IP=20
AUTH_LOCKOUT_SECONDS=300
